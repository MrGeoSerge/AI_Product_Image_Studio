{
  "description": "Шаблон workflow для генерації зображень товарів через ComfyUI",
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "realisticVisionV60B1_v51HyperVAE.safetensors"
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "batch_size": 1,
        "height": 512,
        "width": 512
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["4", 1],
        "text": "{{POSITIVE_PROMPT}}"
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["4", 1],
        "text": "{{NEGATIVE_PROMPT}}"
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "seed": {{SEED}},
        "steps": 20,
        "cfg": 8.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 1.0,
        "model": ["4", 0],
        "positive": ["6", 0],
        "negative": ["7", 0],
        "latent_image": ["5", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["3", 0],
        "vae": ["4", 2]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "product",
        "images": ["8", 0]
      }
    }
  },
  "notes": "Замініть {{POSITIVE_PROMPT}}, {{NEGATIVE_PROMPT}} та {{SEED}} на реальні значення"
}

